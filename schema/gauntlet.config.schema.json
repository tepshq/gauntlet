{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/tepshq/gauntlet/schema/gauntlet.config.schema.json",
  "title": "gauntlet.config.json",
  "description": "対象リポジトリの事実を記録する。閾値やポリシーは全社共通なのでここには入らない。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "adapter",
    "runner",
    "defaultBranch",
    "source"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "adapter": {
      "description": "この言語のソースを読むアダプタ。",
      "enum": [
        "typescript"
      ]
    },
    "runner": {
      "description": "テストランナー。gauntlet がコマンドを組み立てる根拠になる。",
      "enum": [
        "vitest"
      ]
    },
    "defaultBranch": {
      "description": "差分の起点を取る相手。turn と pr はこのブランチとの merge-base を共有する。",
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "include"
      ],
      "properties": {
        "include": {
          "description": "計測対象。POSIX 区切りの glob。",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "commands": {
      "description": "型チェックのコマンド。プロジェクトが標準から外れている場合にのみ書く。",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "typecheck": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
